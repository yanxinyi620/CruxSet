.tab-bar{box-sizing:border-box;display:flex;align-items:center;justify-content:space-around;min-height:116rpx;padding:17rpx 30rpx calc(17rpx + env(safe-area-inset-bottom));background:#28214b;color:#c9c4e5}.tab{box-sizing:border-box;min-width:128rpx;padding:12rpx 0;text-align:center;font-size:32rpx;font-weight:700;letter-spacing:1.3rpx;line-height:1.2}.tab.active{color:#fff;font-weight:900}
