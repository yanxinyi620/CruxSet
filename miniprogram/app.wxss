page{background:#f8f8fc;color:#202039;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}.page{box-sizing:border-box;min-height:100vh;padding:34rpx 36rpx 190rpx}.preview-top{display:flex;align-items:center;justify-content:space-between;color:#6f7187;font-size:22rpx;font-weight:800}.preview-avatar{width:48rpx;height:48rpx;border-radius:50%;background:linear-gradient(140deg,#ef7655,#f6c75c)}.page-title,.title{margin:44rpx 0 12rpx;font-size:68rpx;font-weight:800;letter-spacing:-5rpx;line-height:1}.page-lead,.muted{color:#6f7187;font-size:27rpx;line-height:1.55}.card{background:#fff;border:1rpx solid #e5e5ef;border-radius:20rpx;padding:28rpx;box-shadow:0 9rpx 20rpx rgba(37,31,82,.04)}.button{border-radius:14rpx;background:#6046d6;color:#fff;font-weight:800}.button::after{border:0}.empty{padding:88rpx 0;text-align:center;color:#8a8b9d;font-size:25rpx;line-height:1.6}
