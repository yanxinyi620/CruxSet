page{background:#f8f8fc;color:#202039;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}.page{box-sizing:border-box;min-height:100vh;padding:44rpx 32rpx 190rpx}.page-kicker,.eyebrow{color:#6046d6;font-size:21rpx;font-weight:800;letter-spacing:3rpx;text-transform:uppercase}.page-title,.title{margin:14rpx 0 12rpx;font-size:58rpx;font-weight:800;letter-spacing:-3rpx;line-height:1.08}.page-lead,.muted{color:#6f7187;font-size:26rpx;line-height:1.6}.card{background:#fff;border:1rpx solid #e5e5ef;border-radius:20rpx;padding:28rpx;box-shadow:0 9rpx 20rpx rgba(37,31,82,.04)}.button{border-radius:14rpx;background:#6046d6;color:#fff;font-weight:800}.button::after{border:0}.empty{padding:88rpx 0;text-align:center;color:#8a8b9d;font-size:25rpx;line-height:1.6}
