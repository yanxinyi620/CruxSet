<view class="page"><view class="eyebrow">{{layoutName}}</view><view class="title wall-title">{{wallName}}</view><view class="canvas-wrap"><wall-canvas layout="{{layout}}"/></view><scroll-view scroll-x class="chips"><view class="chip {{angle===item?'active':''}}" wx:for="{{angles}}" wx:key="*this" data-value="{{item}}" bindtap="selectAngle">{{item}}°</view></scroll-view><scroll-view scroll-x class="chips"><view class="chip {{grade===item?'active':''}}" wx:for="{{grades}}" wx:key="*this" data-value="{{item}}" bindtap="selectGrade">{{item}}</view></scroll-view><input class="search" placeholder="搜索编号或线路名称" value="{{query}}" bindinput="setQuery"/><view wx:if="{{problems.length}}" class="problem-list"><view wx:for="{{problems}}" wx:key="id" class="card problem" data-id="{{item.id}}" bindtap="openProblem"><view class="problem-number">{{item.number}}</view><view class="muted">{{item.name}} · {{item.grade}} · {{item.angle}}°</view></view></view><view wx:else class="empty">当前筛选条件下暂无线路</view><button class="button random" bindtap="randomProblem">🎲 随机线路</button></view>
