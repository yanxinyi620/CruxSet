<view class="page"><view class="eyebrow">{{layoutName}}</view><view class="title wall-title">{{wallName}}</view><scroll-view scroll-x class="chips"><view class="chip {{angle===item?'active':''}}" wx:for="{{angles}}" wx:key="*this" data-value="{{item}}" bindtap="selectAngle">{{item}}°</view></scroll-view><scroll-view scroll-x class="chips"><view class="chip {{grade===item?'active':''}}" wx:for="{{grades}}" wx:key="*this" data-value="{{item}}" bindtap="selectGrade">{{item}}</view></scroll-view><input class="search" placeholder="搜索编号或线路名称" value="{{query}}" bindinput="setQuery"/><view class="empty">当前筛选条件下暂无线路</view><button class="button" bindtap="createProblem">＋ 设置线路</button></view>
