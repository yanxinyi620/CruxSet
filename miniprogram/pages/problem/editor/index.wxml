<view class="page editor"><view class="eyebrow">{{wall.name}}</view><view class="title">{{editing?'编辑线路':'设置线路'}}</view><view wx:if="{{editing}}" class="muted">线路编号：{{problemNumber}}</view><view class="meta-row"><picker range="{{angles}}" value="{{angleIndex}}" bindchange="selectAngle"><view class="meta">{{angle}}°</view></picker><picker range="{{grades}}" value="{{gradeIndex}}" bindchange="selectGrade"><view class="meta">{{grade}}</view></picker></view><view class="canvas-wrap"><wall-canvas wall="{{wall}}" bind:holdtap="onHoldTap"/></view><view class="role-row"><view wx:for="{{roles}}" wx:key="id" class="role {{selectedRole===item.id?'role-active':''}}" style="--role-color:{{item.color}}" data-role="{{item.id}}" bindtap="selectRole">{{item.label}}</view></view><view class="card rule"><view class="rule-title">脚点规则</view><picker range="{{footRules}}" value="{{footRuleIndex}}" bindchange="selectFootRule"><view>脚点规则：{{footRuleLabel}}</view></picker><view class="muted">{{footRuleHint}}</view></view><input class="field" placeholder="线路名称（可选）" value="{{name}}" bindinput="setName" maxlength="80"/><textarea class="field description" placeholder="线路说明（可选，500字以内）" value="{{description}}" bindinput="setDescription" maxlength="500"/><view class="hold-grid"><view wx:for="{{wall.holds}}" wx:key="id" class="hold {{selected[item.id]?'hold-selected':''}}" data-id="{{item.id}}" bindtap="selectHold">{{item.id}}</view></view><view class="actions"><button size="mini" bindtap="undo">Undo</button><button size="mini" bindtap="clear">清空</button><button class="button save" bindtap="save">{{editing?'更新线路':'保存线路'}}</button></view></view>
