<view class="page editor"><view class="eyebrow">{{layout.name}}</view><view class="title">设置线路</view><view class="canvas-wrap"><wall-canvas layout="{{layout}}"/></view><view class="role-row"><view wx:for="{{roles}}" wx:key="id" class="role {{selectedRole===item.id?'role-active':''}}" style="--role-color:{{item.color}}" data-role="{{item.id}}" bindtap="selectRole">{{item.label}}</view></view><view class="card rule"><view class="rule-title">脚点规则</view><view>手脚同点 <text class="muted">feet_follow · 默认</text></view><view class="muted">手类点可踩，黄色 Foot 只能脚踩</view></view><view class="hold-grid"><view wx:for="{{layout.holds}}" wx:key="id" class="hold {{selected[item.id]?'hold-selected':''}}" data-id="{{item.id}}" bindtap="selectHold">{{item.id}}</view></view><view class="actions"><button size="mini" bindtap="undo">Undo</button><button size="mini" bindtap="clear">清空</button><button class="button save" bindtap="save">保存线路</button></view></view>
