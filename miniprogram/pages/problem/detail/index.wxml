<view class="page" wx:if="{{problem}}"><view class="eyebrow">{{problem.grade}} · {{problem.angle}}°</view><view class="title">{{problem.number}}</view><view class="subtitle">{{problem.name}}</view><view class="card"><view class="canvas-wrap"><wall-canvas wall="{{wall}}" active-holds="{{activeHolds}}"/></view></view><view class="card"><view class="label">脚点规则</view><view>{{footRuleLabel}}</view><view class="muted">{{footRuleHint}}</view></view><view class="card" wx:if="{{problem.description}}">{{problem.description}}</view><view class="nav"><button size="mini" disabled="{{!previous}}" data-id="{{previous.id}}" bindtap="open">← 上一条</button><button size="mini" disabled="{{!next}}" data-id="{{next.id}}" bindtap="open">下一条 →</button></view></view>
