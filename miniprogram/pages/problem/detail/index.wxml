<view class="page" wx:if="{{problem}}"><view class="eyebrow">{{problem.grade}} · {{problem.angle}}°</view><view class="title">{{problem.number}}</view><view class="subtitle">{{problem.name}}</view><view class="card"><view class="canvas-placeholder">Wall Canvas</view></view><view class="card"><view class="label">脚点规则</view><view>手脚同点</view><view class="muted">Start、Hand、Assist、Finish 可脚踩；黄色 Foot 只能脚踩</view></view><view class="card" wx:if="{{problem.description}}">{{problem.description}}</view><view class="nav"><button size="mini" disabled="{{!previous}}" data-id="{{previous.id}}" bindtap="open">← 上一条</button><button size="mini" disabled="{{!next}}" data-id="{{next.id}}" bindtap="open">下一条 →</button></view></view>
