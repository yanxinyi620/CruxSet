.create-page{padding-bottom:190rpx}.create-hero{position:relative;overflow:hidden;margin:40rpx 0 48rpx;padding:34rpx 34rpx 38rpx;border-radius:24rpx;background:linear-gradient(135deg,#403194,#7354db);box-shadow:0 20rpx 40rpx rgba(76,54,174,.22);color:#fff}.create-hero::after{content:"";position:absolute;right:-40rpx;top:-76rpx;width:230rpx;height:230rpx;border:34rpx solid rgba(255,255,255,.12);border-radius:50%}.create-hero-mark{position:relative;z-index:1;width:52rpx;height:52rpx;border-radius:16rpx;background:rgba(255,255,255,.18);font-size:42rpx;line-height:48rpx;text-align:center}.create-hero-kicker{position:relative;z-index:1;margin-top:34rpx;font-size:21rpx;letter-spacing:2rpx;font-weight:800;opacity:.75}.create-hero-title{position:relative;z-index:1;margin-top:8rpx;font-size:42rpx;font-weight:800;letter-spacing:-2rpx}.create-hero-copy{position:relative;z-index:1;margin-top:10rpx;font-size:24rpx;line-height:1.6;opacity:.82}.section-label{margin:34rpx 0 16rpx;color:#6f7187;font-size:22rpx;font-weight:800;letter-spacing:2rpx}.action-row,.wall-row{display:flex;align-items:center;gap:20rpx;margin-bottom:16rpx;padding:26rpx;border:1rpx solid #e5e5ef;border-radius:20rpx;background:#fff;box-shadow:0 8rpx 18rpx rgba(37,31,82,.035)}.action-symbol{display:grid;place-items:center;width:58rpx;height:58rpx;border-radius:17rpx;background:#eeeaff;color:#6046d6;font-size:30rpx}.action-body,.wall-copy{flex:1;min-width:0}.action-title,.wall-name{font-size:31rpx;font-weight:800;letter-spacing:-1rpx}.action-meta,.wall-meta{margin-top:7rpx;color:#6f7187;font-size:23rpx;line-height:1.45}.action-arrow{color:#6046d6;font-size:44rpx;font-weight:300;line-height:1}.wall-badge{align-self:flex-start;padding:7rpx 11rpx;border-radius:999rpx;background:#ede9ff;color:#6046d6;font-size:20rpx;font-weight:800}.quiet-empty{padding:26rpx 4rpx;color:#8a8b9d;font-size:24rpx;line-height:1.55}
