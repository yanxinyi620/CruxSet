.drafts-page{padding-bottom:70rpx}.action-row{display:flex;align-items:center;gap:20rpx;margin-top:20rpx;padding:26rpx;border:1rpx solid #e5e5ef;border-radius:17rpx;background:#fff}.draft-symbol{display:grid;place-items:center;flex:0 0 auto;width:62rpx;height:62rpx;border-radius:19rpx;background:#eeeaff;color:#6046d6;font-size:30rpx}.action-body{min-width:0;flex:1}.action-title{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:31rpx;font-weight:800}.action-meta{margin-top:7rpx;color:#6f7187;font-size:23rpx;line-height:1.45}.action-arrow{color:#6046d6;font-size:44rpx;font-weight:300}.quiet-empty{padding:26rpx 4rpx;color:#8a8b9d;font-size:24rpx}
