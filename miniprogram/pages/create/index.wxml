<view class="page"><view class="eyebrow">Make a move</view><view class="title">创建</view><view class="card action" bindtap="createWall"><view class="action-icon">＋</view><view><view class="wall-name">新建墙面</view><view class="muted">上传墙图并标注岩点</view></view></view><view class="section-title">新建线路</view><view class="muted">选择自己的墙面或公开墙面。</view><view wx:if="{{loading}}" class="muted">加载墙面中…</view><view wx:for="{{walls}}" wx:key="id" class="card wall" data-id="{{item.id}}" bindtap="openWall"><view class="wall-name">{{item.name}}</view><view class="muted">{{item.visibility==='public'?'公开墙面':'我的私有墙面'}} · 选择后设置线路</view><view class="arrow">→</view></view><view wx:if="{{!loading&&!walls.length}}" class="empty">先新建一面墙，再开始设置线路</view></view>
