<view class="page create-page">
  <view class="preview-top"><view>CRUXSET</view><view class="preview-avatar"></view></view>
  <view class="page-title">创建</view>
  <view class="page-lead">从这里开始新建内容，或继续完成尚未发布的墙面标注。</view>
  <view class="create-hero" bindtap="createWall">
    <view class="create-hero-mark">＋</view>
    <view class="create-hero-kicker">从真实墙面开始</view>
    <view class="create-hero-title">新建墙面</view>
    <view class="create-hero-copy">上传照片、设置可见范围，然后开始首次标注。</view>
  </view>
  <view class="section-label">继续创建</view>
  <view wx:if="{{loading}}" class="quiet-empty">正在整理你的草稿…</view>
  <view wx:for="{{drafts}}" wx:key="layoutId" class="action-row" data-wall-id="{{item.wallId}}" data-layout-id="{{item.layoutId}}" bindtap="resumeDraft">
    <view class="draft-symbol"><view>✦</view></view>
    <view class="action-body"><view class="action-title">{{item.wallName}}</view><view class="action-meta">草稿 · {{item.layoutName}}</view></view>
    <view class="action-arrow">›</view>
  </view>
  <view wx:if="{{!loading&&!drafts.length}}" class="quiet-empty">没有未发布的标注草稿</view>
  <view class="section-label">设置线路</view>
  <view class="wall-row" bindtap="createProblem">
    <view class="route-visual"></view>
    <view class="wall-copy"><view class="wall-name">新建线路</view><view class="wall-meta">选择一个公开 Layout 后开始设置</view></view>
    <view class="action-arrow">›</view>
  </view>
</view>
