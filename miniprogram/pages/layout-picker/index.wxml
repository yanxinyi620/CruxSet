<view class="page"><view class="page-title">选择公开 Layout</view><view class="page-lead">草稿不会出现在这里。</view><view wx:for="{{items}}" wx:key="id" class="card" data-wall-id="{{item.wall.id}}" data-layout-id="{{item.layout.id}}" bindtap="choose"><view class="title-small">{{item.wall.name}}</view><view class="muted">公开 · {{item.layout.name}} · {{item.layout.holds.length}} 个岩点</view></view><view wx:if="{{!items.length}}" class="empty">暂无可选择的公开 Layout</view></view>
