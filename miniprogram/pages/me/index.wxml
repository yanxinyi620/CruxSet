<view class="page me-page">
  <view class="preview-top"><view>CRUXSET</view><view class="preview-avatar"></view></view>
  <view class="page-title">我的</view>
  <view class="page-lead">查看自己创建的墙面及 Layout 状态，或删除不再需要的内容。</view>
  <view wx:if="{{loading}}" class="quiet-empty">正在加载你的墙面…</view>
  <view wx:for="{{walls}}" wx:key="id" class="wall-card">
    <view class="wall-card-head">
      <view class="wall-visual me-wall-visual"><view class="wall-visual-dot"></view></view>
      <view class="wall-card-title"><view class="wall-name">{{item.name}}</view><view class="wall-meta">{{item.visibility==='public'?'公开墙面':'私有墙面'}} · {{item.layouts.length}} 个 Layout</view></view>
      <view class="visibility-chip">{{item.visibility==='public'?'公开':'私有'}}</view>
    </view>
    <view class="layout-list">
      <view wx:for="{{item.layouts}}" wx:for-item="layout" wx:key="id" class="layout-row">
        <view class="layout-copy"><view class="layout-name">{{layout.name}}</view><view class="layout-status {{layout.published?'published':'draft'}}">{{layout.published?'已发布并锁定':'草稿，尚未发布'}}</view></view>
        <button class="delete-layout" size="mini" data-wall-id="{{item.id}}" data-layout-id="{{layout.id}}" data-layout-name="{{layout.name}}" data-published="{{layout.published}}" bindtap="confirmDeleteLayout">删除 Layout</button>
      </view>
    </view>
    <view class="wall-danger"><button class="delete-wall" size="mini" data-wall-id="{{item.id}}" data-wall-name="{{item.name}}" bindtap="confirmDeleteWall">删除墙面</button></view>
  </view>
  <view wx:if="{{!loading&&!walls.length}}" class="quiet-empty">还没有创建墙面。去“创建”开始录入一面墙吧。</view>
</view>
