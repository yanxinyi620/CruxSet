.manage-page{padding-bottom:70rpx}.problem-group{overflow:hidden;margin-top:20rpx;border:1rpx solid #e5e5ef;border-radius:18rpx;background:#fff}.group-head{display:flex;align-items:center;justify-content:space-between;padding:24rpx}.group-wall{font-size:30rpx;font-weight:800}.group-meta{margin-top:8rpx;color:#6f7187;font-size:22rpx}.arrow{color:#6046d6;font-size:38rpx}.problem{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:20rpx 24rpx;border-top:1rpx solid #efeff5;font-size:25rpx;font-weight:800}.problem button{margin:0;color:#c75b49;border:1rpx solid #f0b4aa;background:#fff;font-size:20rpx}.problem button::after{border:0}
