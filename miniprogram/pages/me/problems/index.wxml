<view class="page"><view class="page-title">我的线路</view><view class="page-lead">仅显示由你创建的线路。</view><view wx:for="{{problems}}" wx:key="id" class="card problem"><view data-id="{{item.id}}" bindtap="open">{{item.number}} · {{item.name||'未命名线路'}}<view class="muted">{{item.angle}}° · {{item.grade}}</view></view><button size="mini" data-id="{{item.id}}" bindtap="remove">删除</button></view><view wx:if="{{!problems.length}}" class="empty">还没有创建线路。</view></view>
