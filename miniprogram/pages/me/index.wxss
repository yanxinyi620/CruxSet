.me-page{padding-bottom:190rpx}.wall-card{margin-top:28rpx;padding:28rpx;border:1rpx solid #e5e5ef;border-radius:22rpx;background:#fff;box-shadow:0 9rpx 20rpx rgba(37,31,82,.04)}.wall-card-head{display:flex;justify-content:space-between;gap:16rpx;align-items:flex-start}.wall-name{font-size:33rpx;font-weight:800;letter-spacing:-1rpx}.wall-meta{margin-top:8rpx;color:#6f7187;font-size:23rpx}.visibility-chip{padding:7rpx 11rpx;border-radius:999rpx;background:#ede9ff;color:#6046d6;font-size:20rpx;font-weight:800}.layout-list{margin-top:24rpx;border-top:1rpx solid #eeeef4}.layout-row{display:flex;gap:16rpx;align-items:center;justify-content:space-between;padding:22rpx 0;border-bottom:1rpx solid #eeeef4}.layout-copy{min-width:0;flex:1}.layout-name{font-size:27rpx;font-weight:750;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.layout-status{display:inline-block;margin-top:9rpx;padding:6rpx 10rpx;border-radius:999rpx;font-size:20rpx;font-weight:800}.layout-status.draft{background:#fff4d7;color:#987719}.layout-status.published{background:#e8f7ee;color:#397355}.delete-layout,.delete-wall{margin:0;border:1rpx solid #efc1b7!important;border-radius:12rpx!important;background:#fff!important;color:#c75b49!important;font-size:21rpx!important;line-height:1.8!important}.delete-wall{margin-top:24rpx;padding:4rpx 12rpx}.delete-layout::after,.delete-wall::after{border:0}.quiet-empty{padding:54rpx 4rpx;color:#8a8b9d;font-size:24rpx;line-height:1.6}
