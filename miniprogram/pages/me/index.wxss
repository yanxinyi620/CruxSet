.me-page{padding-bottom:190rpx}.wall-card{margin-top:30rpx;padding:28rpx;border:1rpx solid #e5e5ef;border-radius:24rpx;background:#fff;box-shadow:0 14rpx 28rpx rgba(37,31,82,.055)}.wall-card-head{display:flex;gap:17rpx;align-items:center}.wall-card-title{min-width:0;flex:1}.wall-visual{position:relative;flex:0 0 auto;width:70rpx;height:70rpx;overflow:hidden;border-radius:20rpx;background:linear-gradient(142deg,#5148a6 0 36%,#e58b61 36% 62%,#f4d477 62%)}.wall-visual::after{content:"";position:absolute;left:-12rpx;bottom:-22rpx;width:100rpx;height:48rpx;transform:rotate(-35deg);background:rgba(255,255,255,.22)}.wall-visual-dot{position:absolute;z-index:1;right:11rpx;top:10rpx;width:11rpx;height:11rpx;border-radius:50%;background:#fff7da}.wall-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:32rpx;font-weight:800;letter-spacing:-1rpx}.wall-meta{margin-top:7rpx;color:#6f7187;font-size:22rpx}.visibility-chip{padding:7rpx 11rpx;border-radius:999rpx;background:#ede9ff;color:#6046d6;font-size:20rpx;font-weight:800}.layout-list{margin-top:25rpx;border-top:1rpx solid #eeeef4}.layout-row{display:flex;gap:16rpx;align-items:center;justify-content:space-between;padding:22rpx 0;border-bottom:1rpx solid #eeeef4}.layout-copy{min-width:0;flex:1}.layout-name{font-size:27rpx;font-weight:750;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.layout-status{display:inline-block;margin-top:9rpx;padding:6rpx 10rpx;border-radius:999rpx;font-size:20rpx;font-weight:800}.layout-status.draft{background:#fff4d7;color:#987719}.layout-status.published{background:#e8f7ee;color:#397355}.delete-layout,.delete-wall{margin:0;border:1rpx solid #efc1b7!important;border-radius:12rpx!important;background:#fff!important;color:#c75b49!important;font-size:21rpx!important;line-height:1.8!important}.delete-layout{flex:0 0 auto}.wall-danger{display:flex;justify-content:flex-end;padding-top:22rpx}.delete-wall{padding:4rpx 12rpx}.delete-layout::after,.delete-wall::after{border:0}.quiet-empty{padding:54rpx 4rpx;color:#8a8b9d;font-size:24rpx;line-height:1.6}
.me-page .wall-card{margin-top:22rpx;border-radius:17rpx;box-shadow:0 7rpx 16rpx rgba(38,35,72,.04)}.me-page .wall-card:first-of-type{background:#dff5e7;border-color:#c6ebd2}.me-page .wall-visual{width:84rpx;height:84rpx;border-radius:24rpx}.me-page .visibility-chip{background:#fff6d9;color:#9c7817}.me-page .layout-list{margin-top:20rpx}
