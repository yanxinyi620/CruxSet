.create{margin-bottom:26rpx}.wall-card{padding:28rpx}.wall-head{display:flex;justify-content:space-between;align-items:center}.wall-name{font-size:34rpx;font-weight:750;margin-bottom:8rpx}.arrow{font-size:36rpx;color:#df792b}.layout-row{display:flex;align-items:center;justify-content:space-between;padding:24rpx 0;border-bottom:1rpx solid #edf0e9}.layout-name{font-size:29rpx;font-weight:650;margin-bottom:6rpx}.small-action{margin:0;background:#e8f7ba;color:#273313;border:0;border-radius:999rpx;font-size:23rpx}.locked{font-size:23rpx;color:#7c8278}.new-layout{margin:22rpx 0 0;padding:0;background:transparent;color:#c96725;font-size:26rpx;text-align:left;border:0}.new-layout::after{border:0}.empty{padding:88rpx 0;text-align:center;color:#788074}
