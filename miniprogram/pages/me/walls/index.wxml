<view class="page manage-page"><view class="page-title">我的墙面</view><view class="page-lead">查看所有 Layout 状态，并在这里删除。</view><view wx:for="{{layouts}}" wx:key="id" class="layout-card"><view class="layout-copy"><view class="layout-wall">{{item.wallName}}</view><view class="layout-meta"><text class="state {{item.published?'public':'draft'}}">{{item.published?'公开':'草稿'}}</text><text>{{item.layoutName}}</text></view></view><button class="delete" size="mini" data-wall-id="{{item.wallId}}" data-layout-id="{{item.id}}" bindtap="remove">删除</button></view><view wx:if="{{!layouts.length}}" class="empty">还没有创建墙面。</view></view>
