<view class="page manage-page"><view class="page-title">我的墙面</view><view class="page-lead">查看所有 墙面 状态，并在这里删除。</view><view wx:for="{{walls}}" wx:key="id" class="wall-card"><view class="wall-copy"><view class="wall-name">{{item.name}}</view><view class="wall-meta"><text class="state {{item.visibility==='public'?'public':'draft'}}">{{item.visibility==='public'?'公开':'草稿'}}</text><text>{{item.name}}</text></view></view><button class="delete" size="mini" data-wall-id="{{item.id}}"  bindtap="remove">删除</button></view><view wx:if="{{!walls.length}}" class="empty">还没有创建墙面。</view></view>
