.lines-page{padding-bottom:190rpx}.line-wall-card{margin-top:26rpx;padding:28rpx;border:1rpx solid #e5e5ef;border-radius:24rpx;background:#fff;box-shadow:0 14rpx 28rpx rgba(37,31,82,.055)}.wall-card-top{display:flex;align-items:center;gap:18rpx}.wall-title-wrap{min-width:0;flex:1}.wall-visual{position:relative;flex:0 0 auto;width:74rpx;height:74rpx;overflow:hidden;border-radius:21rpx;background:linear-gradient(142deg,#5148a6 0 36%,#e58b61 36% 62%,#f4d477 62%)}.wall-visual::after{content:"";position:absolute;left:-12rpx;bottom:-22rpx;width:100rpx;height:48rpx;transform:rotate(-35deg);background:rgba(255,255,255,.22)}.wall-visual-dot{position:absolute;z-index:1;right:12rpx;top:11rpx;width:12rpx;height:12rpx;border-radius:50%;background:#fff7da}.wall-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:33rpx;font-weight:800;letter-spacing:-1.2rpx}.wall-arrow{color:#6046d6;font-size:48rpx;font-weight:300;line-height:1}.layout-label{margin-top:6rpx;color:#6f7187;font-size:23rpx;line-height:1.4}.wall-card-bottom{display:flex;align-items:center;gap:12rpx;margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid #efeff5}.public-chip{padding:7rpx 11rpx;border-radius:999rpx;background:#ede9ff;color:#6046d6;font-size:20rpx;font-weight:800}.angle-label{color:#4d4f66;font-size:22rpx}.layout-ready{margin-left:auto;color:#8a8b9d;font-size:20rpx}.quiet-empty{padding:54rpx 4rpx;color:#8a8b9d;font-size:24rpx;line-height:1.6}.error-card{margin-top:28rpx;padding:25rpx;border:1rpx solid #ffd6ca;border-radius:18rpx;background:#fff8f5;color:#bd5c43;font-size:25rpx}.error-copy{margin-top:8rpx;color:#8a8b9d;font-size:22rpx}
