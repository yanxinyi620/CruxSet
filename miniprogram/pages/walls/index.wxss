.lines-page{padding-bottom:190rpx}.line-wall-card{margin-top:24rpx;padding:28rpx;border:1rpx solid #e5e5ef;border-radius:22rpx;background:#fff;box-shadow:0 10rpx 22rpx rgba(37,31,82,.045)}.wall-card-top{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.wall-name{font-size:34rpx;font-weight:800;letter-spacing:-1rpx}.wall-arrow{color:#6046d6;font-size:48rpx;font-weight:300;line-height:1}.layout-label{margin-top:13rpx;color:#6f7187;font-size:24rpx;line-height:1.45}.wall-card-bottom{display:flex;align-items:center;gap:14rpx;margin-top:24rpx}.public-chip{padding:7rpx 11rpx;border-radius:999rpx;background:#ede9ff;color:#6046d6;font-size:20rpx;font-weight:800}.angle-label{color:#4d4f66;font-size:23rpx}.quiet-empty{padding:54rpx 4rpx;color:#8a8b9d;font-size:24rpx;line-height:1.6}.error-card{margin-top:28rpx;padding:25rpx;border:1rpx solid #ffd6ca;border-radius:18rpx;background:#fff8f5;color:#bd5c43;font-size:25rpx}.error-copy{margin-top:8rpx;color:#8a8b9d;font-size:22rpx}
