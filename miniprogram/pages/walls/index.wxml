<view class="page lines-page">
  <view class="page-kicker">FIND A WALL</view>
  <view class="page-title">找线路</view>
  <view class="page-lead">先选择一面公开墙，再选择 Layout 和线路。</view>
  <view wx:if="{{loading}}" class="quiet-empty">正在加载公开墙面…</view>
  <view wx:if="{{error}}" class="error-card"><view>{{error}}</view><view class="error-copy">当前显示本地示例数据</view></view>
  <view wx:for="{{walls}}" wx:key="id" class="line-wall-card" data-id="{{item.id}}" bindtap="openWall">
    <view class="wall-card-top"><view class="wall-name">{{item.name}}</view><view class="wall-arrow">›</view></view>
    <view class="layout-label">{{item.layoutName}}</view>
    <view class="wall-card-bottom"><view class="public-chip">公开</view><view class="angle-label">{{item.anglesLabel}}</view></view>
  </view>
  <view wx:if="{{!loading && !error && !walls.length}}" class="empty">暂无公开墙面</view>
</view>

