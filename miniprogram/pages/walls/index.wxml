<view class="page"><view class="eyebrow">Climb · Create · Share</view><view class="title">选择墙面</view><view wx:if="{{loading}}" class="muted">加载墙面中…</view><view wx:if="{{error}}" class="card error">{{error}}<view class="muted">当前显示本地示例数据</view></view><view wx:for="{{walls}}" wx:key="id" class="card wall" data-id="{{item.id}}" bindtap="openWall"><view class="wall-name">{{item.name}}</view><view class="muted">{{item.layoutName}}</view><view class="angles">{{item.angles.join('° · ')}}°</view><view class="arrow">→</view></view><view wx:if="{{!loading && !error && !walls.length}}" class="empty">暂无墙面</view></view>
