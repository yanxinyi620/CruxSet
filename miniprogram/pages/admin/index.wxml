<view class="page"><view class="eyebrow">My Wall</view><view class="title">新建墙面</view><input class="field" placeholder="Wall 名称" bindinput="setWallName"/><input class="field" placeholder="Layout 名称" bindinput="setLayoutName"/><picker range="{{visibilityOptions}}" bindchange="setVisibility"><view class="field">可见性：{{visibility==='public'?'公开':'私有'}}</view></picker><button class="button upload" bindtap="chooseImage">{{imageFileId?'重新上传墙图':'选择墙图'}}</button><image wx:if="{{imagePath}}" class="preview" src="{{imagePath}}" mode="aspectFill"/><view class="muted">创建后将进入 Hold 标注页面</view><button class="button" loading="{{saving}}" bindtap="create">创建并开始标注</button></view>
