<view class="page"><view class="eyebrow">{{wallId}}</view><view class="title">墙面标注</view><view wx:if="{{lockMessage}}" class="locked-note">{{lockMessage}}</view><block wx:if="{{editable}}"><button class="button upload" bindtap="chooseImage">{{imageFileId?'重新上传墙图':'上传墙图'}}</button></block><view class="card"><view class="canvas" catchtap="addHold"><image wx:if="{{localImagePath}}" class="wall-image" src="{{localImagePath}}" mode="aspectFill"/><image wx:elif="{{displayImageUrl}}" class="wall-image" src="{{displayImageUrl}}" mode="aspectFill"/><view class="hint" wx:else>点击墙面添加 Hold</view><view wx:for="{{holds}}" wx:key="id" class="dot" style="left:{{item.x*100}}%;top:{{item.y*100}}%">{{item.id}}</view></view></view><block wx:if="{{editable}}"><view class="tools"><text>连续标点</text><switch checked="{{continuous}}" bindchange="setContinuous"/><text>Volume</text><switch checked="{{kind==='volume'}}" bindchange="setKind"/></view><view class="card"><view wx:for="{{holds}}" wx:key="id" class="hold-row"><text>{{item.id}} · {{item.kind}}</text><button size="mini" data-id="{{item.id}}" bindtap="remove">删除</button><slider min="0" max="1" step="0.01" value="{{item.x}}" data-id="{{item.id}}" bindchange="moveHold"/><slider min="0.001" max="0.08" step="0.001" value="{{item.radius}}" data-id="{{item.id}}" bindchange="resizeHold"/></view></view><view class="actions"><button size="mini" bindtap="undo">Undo</button><button class="button" bindtap="publish">发布墙面</button></view></block></view>
