<view class="page"><view class="eyebrow">日坛 Spraywall · 2026-08</view><view class="title">Layout Editor</view><view class="card"><view class="canvas" catchtap="addHold" data-x="0.5" data-y="0.5"><view class="hint">点击墙面添加 Hold</view><view wx:for="{{holds}}" wx:key="id" class="dot" style="left:{{item.x*100}}%;top:{{item.y*100}}%">{{item.id}}</view></view></view><view class="tools"><text>连续标点</text><switch checked="{{continuous}}" bindchange="setContinuous"/><text>Volume</text><switch checked="{{kind==='volume'}}" bindchange="setKind"/></view><view class="card"><view wx:for="{{holds}}" wx:key="id" class="hold-row"><text>{{item.id}} · {{item.kind}}</text><button size="mini" data-id="{{item.id}}" bindtap="remove">删除</button></view></view><view class="actions"><button size="mini" bindtap="undo">Undo</button><button class="button" bindtap="publish">发布 Layout</button></view></view>
