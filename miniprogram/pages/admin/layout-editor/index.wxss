.upload{margin-bottom:20rpx}.canvas{height:700rpx;background:#d8d8d0;border-radius:20rpx;position:relative}.hint{position:absolute;left:0;right:0;top:48%;text-align:center;color:#788074}.dot{position:absolute;transform:translate(-50%,-50%);background:#316eea;color:#fff;border-radius:50%;width:58rpx;height:58rpx;text-align:center;line-height:58rpx;font-size:16rpx}.tools{display:flex;align-items:center;gap:14rpx;margin:24rpx 0}.hold-row{display:flex;justify-content:space-between;align-items:center;padding:12rpx 0}.actions{display:flex;gap:16rpx}.actions .button{flex:1}
