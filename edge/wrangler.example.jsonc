{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cruxset-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/v1/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cruxset-edge",
      "database_id": "REPLACE_AFTER_WRANGLER_D1_CREATE",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "cruxset-media" }]
}
