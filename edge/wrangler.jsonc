{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cruxset-edge",
  "main": "src/index.ts",
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"] }],
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "api.cruxset.xinyilab.top",
      "custom_domain": true
    },
    {
      "pattern": "cruxset.xinyilab.top",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/v1/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cruxset-db",
      "database_id": "f536b4b2-0b2f-4811-8351-3aeb9c3183d3",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "cruxset-media" }]
}
