.create-page{padding-bottom:190rpx}.create-hero{position:relative;overflow:hidden;margin:42rpx 0 50rpx;padding:34rpx 34rpx 38rpx;border-radius:26rpx;background:linear-gradient(135deg,#403194,#7354db);box-shadow:0 22rpx 42rpx rgba(76,54,174,.24);color:#fff}.create-hero::after{content:"";position:absolute;right:-40rpx;top:-76rpx;width:230rpx;height:230rpx;border:34rpx solid rgba(255,255,255,.12);border-radius:50%}.create-hero-mark{position:relative;z-index:1;width:54rpx;height:54rpx;border-radius:17rpx;background:rgba(255,255,255,.18);font-size:42rpx;line-height:50rpx;text-align:center}.create-hero-kicker{position:relative;z-index:1;margin-top:34rpx;font-size:21rpx;letter-spacing:2rpx;font-weight:800;opacity:.75}.create-hero-title{position:relative;z-index:1;margin-top:8rpx;font-size:43rpx;font-weight:800;letter-spacing:-2rpx}.create-hero-copy{position:relative;z-index:1;margin-top:10rpx;font-size:24rpx;line-height:1.6;opacity:.82}.section-label{margin:36rpx 0 16rpx;color:#6f7187;font-size:22rpx;font-weight:800;letter-spacing:2rpx}.action-row,.wall-row{display:flex;align-items:center;gap:20rpx;margin-bottom:16rpx;padding:26rpx;border:1rpx solid #e5e5ef;border-radius:22rpx;background:#fff;box-shadow:0 10rpx 20rpx rgba(37,31,82,.04)}.draft-symbol,.route-visual{display:grid;place-items:center;flex:0 0 auto;width:62rpx;height:62rpx;border-radius:19rpx;background:#eeeaff;color:#6046d6;font-size:30rpx}.route-visual{background:linear-gradient(140deg,#523fa4 0 35%,#ef8b65 35% 61%,#f6d470 61%)}.action-body,.wall-copy{flex:1;min-width:0}.action-title,.wall-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:31rpx;font-weight:800;letter-spacing:-1rpx}.action-meta,.wall-meta{margin-top:7rpx;color:#6f7187;font-size:23rpx;line-height:1.45}.action-arrow{color:#6046d6;font-size:44rpx;font-weight:300;line-height:1}.quiet-empty{padding:26rpx 4rpx;color:#8a8b9d;font-size:24rpx;line-height:1.55}
.create-page .create-hero{margin:34rpx 0 38rpx;padding:34rpx;border-radius:20rpx;background:linear-gradient(135deg,#6548d8,#8368e8)}.create-page .create-hero-mark{display:none}.create-page .create-hero-kicker{margin-top:0;font-size:21rpx}.create-page .section-label{margin:34rpx 0 14rpx;font-size:22rpx}.create-page .action-row,.create-page .wall-row{padding:26rpx;border-radius:17rpx;box-shadow:none}
