.create-page{padding-bottom:calc(190rpx + env(safe-area-inset-bottom))}.create-page .page-lead{margin-bottom:26rpx}.action-row,.wall-row{display:flex;align-items:center;gap:26rpx;margin:22rpx 0;padding:34rpx;border:1rpx solid #ddd7ff;border-radius:38rpx;background:#eeeaff}.action-row.walls{background:#dff5e7;border-color:#c6ebd2}.draft-symbol,.route-visual{display:flex;align-items:center;justify-content:center;flex:0 0 auto;width:92rpx;height:92rpx;border-radius:28rpx;background:#fff;color:#6046d6;font-size:46rpx;line-height:1}.action-body,.wall-copy{flex:1;min-width:0}.action-title,.wall-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:38rpx;font-weight:800;line-height:1.35}.action-meta,.wall-meta{margin-top:6rpx;color:#6f7187;font-size:25rpx;line-height:1.45;word-break:break-all}.action-arrow{flex:none;color:#6046d6;font-size:48rpx;font-weight:700;line-height:1}.quiet-empty{padding:4rpx 0;color:#6f7187;font-size:25rpx;line-height:1.55;word-break:break-all}.quiet-empty button{display:block;margin:18rpx 0}
