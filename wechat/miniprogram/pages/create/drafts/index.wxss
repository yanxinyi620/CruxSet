.draft-card{position:relative;margin-top:24rpx;padding:30rpx 72rpx 30rpx 30rpx;border-radius:34rpx}.draft-name{font-size:31rpx;font-weight:800;line-height:1.45;margin-bottom:8rpx;word-break:break-all}.draft-card .muted{font-size:25rpx;line-height:1.5}.arrow{position:absolute;right:28rpx;top:50%;transform:translateY(-50%);font-size:48rpx;color:#6046d6}.error-card{margin-top:24rpx;padding:24rpx;border-radius:20rpx;background:#fff1f3;color:#a72f46;font-size:26rpx;line-height:1.6;word-break:break-all}.error-card button{display:block;margin:16rpx 0 0}

.draft-card{background:#e4f7e8;border:1rpx solid #d8eadc;padding-top:26rpx;padding-bottom:26rpx}.draft-name{font-size:30rpx;margin-bottom:4rpx}
