<view class="page"><view class="title">标注岩点</view><view class="page-lead">选择一面私有草稿墙面，继续标注。</view><view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:elif="{{!allowed}}" class="empty">仅管理员可标注墙面。</view><view wx:if="{{error}}" class="error-card">{{error}}<button size="mini" bindtap="reload">重试</button></view><block wx:if="{{allowed}}"><view wx:for="{{walls}}" wx:key="id" class="card draft-card" data-id="{{item.id}}" bindtap="resumeDraft"><view class="draft-name">{{item.name}}</view><view class="muted">{{item.holds.length}} 个岩点 · 私有草稿</view><view class="arrow">›</view></view><view wx:if="{{!loading && !error && !walls.length}}" class="empty">没有待标注的草稿墙面。</view></block></view>
