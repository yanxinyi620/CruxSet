.profile-page{padding-bottom:80rpx}.profile-page .card{margin-top:24rpx;padding:36rpx;border-radius:38rpx;background:#fffaf0;border-color:#f1dfbf}.label{font-size:25rpx;font-weight:800;color:#8b7143;line-height:1.5}.profile-page .muted{margin-top:12rpx;font-size:25rpx;word-break:break-all}.profile-page input{box-sizing:border-box;width:100%;height:88rpx;margin:22rpx 0 18rpx;padding:20rpx 24rpx;border:1rpx solid #e5e5ef;border-radius:20rpx;background:#fff;font-size:30rpx;color:#202039}.primary{width:100%;margin-top:28rpx;background:#6046d6;color:#fff;font-weight:800}.error-card{margin-top:24rpx;padding:24rpx;border-radius:20rpx;background:#fff1f3;color:#a72f46;font-size:26rpx;line-height:1.6;word-break:break-all}

.contact-admin{width:100%;margin-top:24rpx;color:#5240bb;background:#fff;border-color:#d8d2f4}.contact-panel{margin-top:20rpx;padding:28rpx;border:1rpx solid #e3e2f1;border-radius:24rpx;background:#fff}.contact-email{display:block;margin:18rpx 0 24rpx;font-size:28rpx;overflow-wrap:anywhere;color:#202039}.contact-panel button{margin:0;color:#5240bb;background:#f0edff}
