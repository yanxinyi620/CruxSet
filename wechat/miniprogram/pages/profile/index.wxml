<view class="page profile-page"><view class="page-title">个人资料</view><view class="page-lead">微信身份信息</view><view class="card"><view class="label">微信身份</view><view class="muted">当前微信账号</view></view><view class="card"><view class="label">CruxSet 昵称</view><input value="{{displayName}}" placeholder="未设置昵称" maxlength="40" bindinput="onInput"/><view class="muted">仅用于小程序内容，不会修改微信昵称</view></view><view wx:if="{{error}}" class="error-card">{{error}}</view><button class="primary" loading="{{saving}}" bindtap="save">保存</button></view>
