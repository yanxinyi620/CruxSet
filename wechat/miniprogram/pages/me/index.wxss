.me-hub{padding-bottom:calc(190rpx + env(safe-area-inset-bottom))}.me-hub .page-title{font-size:64rpx}.hub-card{display:flex;align-items:center;gap:26rpx;margin-top:24rpx;padding:34rpx;border-radius:38rpx;border:1rpx solid #e5e5ef;background:#fff}.hub-card.profile{background:#fff3dd;border-color:#f1dfbf}.hub-card.walls{background:#dff5e7;border-color:#c6ebd2}.hub-card.problems{background:#eeeaff;border-color:#ddd7ff}.hub-card.admin-management{background:#e6efff;border-color:#ceddff}.hub-icon{display:flex;align-items:center;justify-content:center;width:92rpx;height:92rpx;flex:none;border-radius:28rpx;background:#fff;color:#6046d6;font-size:46rpx}.hub-copy{flex:1;min-width:0}.hub-title{font-size:38rpx;font-weight:800;line-height:1.35}.hub-meta{margin-top:6rpx;color:#6f7187;font-size:25rpx;line-height:1.45;word-break:break-all}.hub-arrow{flex:none;color:#6046d6;font-size:48rpx}.error-card{margin-top:24rpx;padding:24rpx;border-radius:20rpx;background:#fff1f3;color:#a72f46;font-size:26rpx;line-height:1.6;word-break:break-all}.error-card button{display:block;margin:16rpx 0 0}
