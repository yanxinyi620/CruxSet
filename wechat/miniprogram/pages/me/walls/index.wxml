<view class="page management-page"><view class="title">我的墙面</view><view class="page-lead">管理自己拥有的墙面与关联线路。</view><view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:if="{{error}}" class="error-card">{{error}}<button size="mini" bindtap="reload">重试</button></view><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{!loading && !walls.length && !error}}" class="empty">暂无自己创建的墙面。</view><view wx:for="{{walls}}" wx:key="id" class="card management-card"><view class="wall-visual"></view><view class="wall-copy"><view class="card-head"><view class="wall-name">{{item.wallNumber?'#'+item.wallNumber+' ':''}}{{item.name}}</view><view class="status {{item.visibility!=='public'?'draft':''}}">{{item.deleting?'删除中':item.visibility==='public'?'公开':'私有草稿'}}</view></view><view class="muted">{{item.holdCount}} 个岩点</view></view><button size="mini" class="delete" data-wall-id="{{item.id}}" bindtap="remove" disabled="{{!!deleting}}" loading="{{deleting===item.id}}">{{item.deleting?'继续删除':'删除'}}</button></view></view>
