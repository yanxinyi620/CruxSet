.management-page{padding-bottom:48rpx}.management-card{margin-top:24rpx}.card-head{display:flex;gap:18rpx;align-items:flex-start;margin-bottom:16rpx}.wall-name{flex:1;font-size:31rpx;font-weight:800;word-break:break-all}.status{padding:6rpx 12rpx;background:#eeeaff;color:#6046d6;border-radius:10rpx;font-size:22rpx;white-space:nowrap}.delete{margin:24rpx 0 0;color:#b43f55;background:#fff1f3}.notice{margin-top:24rpx;color:#426d4c;font-size:25rpx}.error-card{margin-top:24rpx;padding:24rpx;background:#fff1f3;border-radius:16rpx;color:#a72f46}.tabs{display:flex;gap:20rpx;margin-top:32rpx}.tabs button{flex:1;font-size:28rpx}.tabs .selected{background:#6046d6;color:#fff}.user-id{font-size:22rpx;color:#8a8b9d;margin-top:12rpx;word-break:break-all}
