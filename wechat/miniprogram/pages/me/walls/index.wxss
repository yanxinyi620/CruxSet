.management-page{padding-bottom:48rpx}.management-card{margin-top:20rpx;padding:28rpx;border-radius:34rpx}.card-head{display:flex;gap:16rpx;align-items:flex-start;margin-bottom:12rpx}.wall-name{flex:1;min-width:0;font-size:31rpx;font-weight:800;line-height:1.4;word-break:break-all}.status{flex:none;padding:8rpx 14rpx;background:#e5f8e9;color:#28734a;border-radius:999rpx;font-size:21rpx;font-weight:800;line-height:1.4;white-space:nowrap}.status.draft{background:#fff5dc;color:#9b7817}.management-card .muted{margin-top:8rpx;font-size:23rpx;word-break:break-all}.delete{margin:24rpx 0 0;padding:14rpx 20rpx;min-height:64rpx;border:1rpx solid #efb9b5;border-radius:20rpx;color:#bb4d49;background:#fff;font-size:23rpx;font-weight:800}.notice{margin-top:24rpx;color:#426d4c;font-size:25rpx;line-height:1.6;word-break:break-all}.error-card{margin-top:24rpx;padding:24rpx;background:#fff1f3;border-radius:20rpx;color:#a72f46;font-size:26rpx;line-height:1.6;word-break:break-all}.error-card button{display:block;margin:16rpx 0 0}.tabs{display:flex;gap:8rpx;padding:8rpx;margin-top:34rpx;background:#ececf5;border-radius:28rpx}.tabs button{flex:1;min-width:0;margin:0;padding:18rpx 12rpx;min-height:72rpx;font-size:27rpx;font-weight:800;border:0;border-radius:20rpx;background:transparent;color:#686986}.tabs .selected{background:#fff;color:#202039;box-shadow:0 4rpx 16rpx #27224412}.user-id{font-size:22rpx;color:#8a8b9d;margin-top:12rpx;line-height:1.5;word-break:break-all}

.management-card{display:flex;align-items:center;gap:20rpx;padding:24rpx 28rpx;border-radius:30rpx}.wall-visual{width:80rpx;height:80rpx;flex:none;border-radius:22rpx;background:linear-gradient(140deg,#7564dc 0%,#7564dc 38%,#fb9453 38%,#fb9453 70%,#f9d978 70%)}.wall-copy{flex:1;min-width:0}.card-head{flex-wrap:wrap;gap:8rpx;margin-bottom:0}.wall-name{flex-basis:100%;font-size:29rpx}.status{padding:2rpx 10rpx;font-size:20rpx}.management-card .muted{margin-top:4rpx;font-size:22rpx}.management-card .delete{flex:none;margin:0;padding:12rpx 18rpx;font-size:23rpx;min-height:60rpx}
