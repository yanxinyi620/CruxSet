.manage-page{padding-bottom:70rpx}.wall-card{display:flex;align-items:center;gap:18rpx;margin-top:20rpx;padding:24rpx;border:1rpx solid #e5e5ef;border-radius:18rpx;background:#fff}.wall-copy{min-width:0;flex:1}.wall-name{font-size:31rpx;font-weight:800}.wall-meta{display:flex;align-items:center;gap:12rpx;margin-top:10rpx;color:#6f7187;font-size:22rpx}.state{padding:4rpx 10rpx;border-radius:999rpx;font-size:19rpx;font-weight:800}.state.public{background:#e0f6e8;color:#327150}.state.draft{background:#fff3d6;color:#a3721b}.delete{margin:0;color:#c75b49;border:1rpx solid #f0b4aa;background:#fff;font-size:21rpx}.delete::after{border:0}
