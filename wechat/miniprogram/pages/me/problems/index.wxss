.manage-page{padding-bottom:70rpx}.problem-group{overflow:hidden;margin-top:24rpx;border:1rpx solid #e5e5ef;border-radius:34rpx;background:#fff}.group-head{display:flex;align-items:center;gap:24rpx;padding:28rpx}.group-copy{flex:1;min-width:0}.group-wall{font-size:31rpx;font-weight:800;line-height:1.45;word-break:break-all}.group-meta{margin-top:6rpx;color:#6f7187;font-size:23rpx;line-height:1.5}.arrow{flex:none;color:#6046d6;font-size:36rpx}.problem-list{padding:0 26rpx 26rpx}.problem{display:flex;align-items:center;gap:14rpx;margin-top:14rpx;padding:20rpx;border-radius:22rpx;background:#f8f8fc}.problem-copy{flex:1;min-width:0;line-height:1.5}.problem-number{font-size:24rpx;font-weight:800;color:#6046d6;word-break:break-all}.problem-name{font-size:24rpx;color:#4d4f66;word-break:break-all}.problem-meta{font-size:22rpx;color:#6f7187}.problem button{flex:none;margin:0;padding:14rpx 16rpx;min-height:64rpx;border-radius:20rpx;background:#fff;font-size:23rpx;font-weight:800}.problem .edit{color:#5240bb;border-color:#d8d2f4}.problem .delete{color:#c75b49;border-color:#efc1b7}.error-card{margin-top:24rpx;padding:24rpx;border-radius:20rpx;background:#fff1f3;color:#a72f46;font-size:26rpx;line-height:1.6;word-break:break-all}.error-card button{display:block;margin:16rpx 0 0}
