<view class="page manage-page"><view class="page-title">我的线路</view><view class="page-lead">仅显示由你创建的线路，按 墙面 管理。</view><view wx:if="{{error}}" class="error-card">{{error}}</view><view wx:for="{{groups}}" wx:key="id" class="problem-group"><view class="group-head" data-id="{{item.id}}" bindtap="toggle"><view><view class="group-wall">{{item.wallName}}</view><view class="group-meta">公开 · {{item.wallName}} · {{item.problems.length}} 条线路</view></view><view class="arrow">{{item.expanded?'⌃':'›'}}</view></view><view wx:if="{{item.expanded}}" wx:for="{{item.problems}}" wx:for-item="problem" wx:key="id" class="problem"><view data-id="{{problem.id}}" bindtap="open"><view>{{problem.number}} · {{problem.name||'未命名线路'}}</view><view class="muted">{{problem.angle}}° · {{problem.grade}}</view></view><button size="mini" data-id="{{problem.id}}" bindtap="edit">编辑</button><button size="mini" data-id="{{problem.id}}" bindtap="remove">删除</button></view></view><view wx:if="{{!groups.length}}" class="empty">还没有创建线路。</view></view>
