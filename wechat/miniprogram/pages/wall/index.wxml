<view class="page wall-overview"><view wx:if="{{loading}}" class="quiet-empty">正在加载墙面…</view><view wx:if="{{error}}" class="error-card">{{error}}</view><block wx:if="{{wall}}"><view class="title wall-title">{{wallName}}</view><view class="subtitle">{{wall.holds.length}} 个岩点</view><view wx:if="{{wall.description}}" class="description">{{wall.description}}</view><view class="canvas-wrap" style="height:{{canvasHeight}}rpx"><wall-canvas class="wall-surface" wall="{{wall}}"/></view><button class="browse-entry" bindtap="openRouteBrowser"><view>浏览线路</view><view class="entry-hint">按角度、难度查找并查看线路</view></button></block></view>