.line-wall-card{display:flex;align-items:center;gap:22rpx;margin:22rpx 0;padding:28rpx;border:1rpx solid #e3e2f1;border-radius:32rpx;background:#fff}.wall-visual{width:80rpx;height:80rpx;flex:none;border-radius:22rpx;background:linear-gradient(145deg,#6f68d5 0 36%,#f39263 36% 68%,#f5d77e 68%)}.wall-copy{flex:1;min-width:0}.wall-name{font-size:32rpx;font-weight:800;overflow-wrap:anywhere}.wall-meta{margin-top:6rpx;font-size:24rpx;color:#6f7187}.wall-arrow{font-size:42rpx;color:#6352e2}.card-pressed{background:#f1effd}
