.upload-page{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.upload-page .title{margin-top:0}.upload-page .page-lead{font-size:25rpx}.image-picker{box-sizing:border-box;min-height:180rpx;margin:30rpx 0 16rpx;padding:30rpx;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:8rpx;background:#f5f3ff;border:2rpx dashed #aaa6dc;border-radius:32rpx;color:#493eb6;font-size:30rpx;font-weight:800}.image-picker image{width:100%;height:380rpx}.image-picker .muted{font-size:23rpx;font-weight:600}.picker-icon{display:none}.upload-page button[size=mini]{margin:0;padding:14rpx 22rpx;min-height:64rpx;font-size:24rpx}.field-label{margin:30rpx 0 12rpx;font-size:24rpx;font-weight:800;color:#6f7187}.field{box-sizing:border-box;width:100%;height:88rpx;background:#fff;border:1rpx solid #e5e5ef;border-radius:22rpx;padding:20rpx 24rpx;font-size:28rpx}.upload-hint{margin:18rpx 0 28rpx;font-size:23rpx;line-height:1.6}.notice{color:#493eb6;background:#eeeaff;border-radius:20rpx;padding:20rpx;font-size:24rpx;line-height:1.5;margin:20rpx 0;word-break:break-all}.upload-page .button{width:100%;font-size:28rpx;font-weight:800}.error-card{margin-top:22rpx;padding:24rpx;background:#fff1f3;color:#a72f46;border-radius:20rpx;font-size:25rpx;line-height:1.6;word-break:break-all}.processor{position:fixed;left:-3000px;top:0;width:640px;height:640px;pointer-events:none}
