.upload-page{padding-bottom:48rpx}.image-picker{height:520rpx;margin:32rpx 0 20rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16rpx;background:#eeeaff;border:2rpx dashed #b9a9ec;border-radius:20rpx;color:#6046d6;font-size:30rpx}.image-picker image{width:100%;height:100%}.picker-icon{font-size:70rpx}.field-label{margin:36rpx 0 14rpx;font-size:28rpx;font-weight:700}.field{background:#fff;border:1rpx solid #e5e5ef;border-radius:14rpx;padding:24rpx;font-size:30rpx}.upload-hint{margin:22rpx 0 30rpx;font-size:24rpx}.notice{color:#6046d6;font-size:25rpx;margin:22rpx 0}.error-card{margin-top:22rpx;padding:24rpx;background:#fff1f3;color:#a72f46;border-radius:14rpx}.processor{position:fixed;left:-3000px;top:0;width:640px;height:640px;pointer-events:none}
