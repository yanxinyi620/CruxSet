<view class="page management-page"><view class="title">管理中心</view><view class="page-lead">查看全站墙面和用户。</view><view wx:if="{{error}}" class="error-card">{{error}}<button size="mini" bindtap="reload">重试</button></view><view wx:if="{{refreshNotice}}" class="page-lead">{{refreshNotice}} <text bindtap="reload">重试</text></view><view wx:if="{{refreshing}}" class="page-lead">正在更新…</view><view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:elif="{{!error && !allowed}}" class="empty">没有管理权限。</view><block wx:if="{{allowed}}"><view class="tabs"><button class="{{tab==='walls'?'selected':''}}" data-tab="walls" bindtap="selectTab">墙面 {{walls.length}}</button><button class="{{tab==='users'?'selected':''}}" data-tab="users" bindtap="selectTab">用户 {{users.length}}</button></view><view wx:if="{{notice}}" class="notice">{{notice}}</view><block wx:if="{{tab==='walls'}}"><view wx:for="{{walls}}" wx:key="id" class="card management-card"><view class="card-head"><view class="wall-name">#{{item.wallNumber}} {{item.name}}</view><view class="status {{item.visibility!=='public'?'draft':''}}">{{item.deleting?'删除中':item.visibility==='public'?'公开':'草稿'}}</view></view><view class="muted">创建者：{{item.ownerName}}</view><view class="muted">创建于 {{item.date}}</view><button size="mini" class="delete" data-wall-id="{{item.id}}" bindtap="remove" disabled="{{!!deleting}}" loading="{{deleting===item.id}}">{{item.deleting?'继续删除':'删除墙面'}}</button></view><view wx:if="{{!walls.length && !loading && !error}}" class="empty">暂无墙面。</view><button size="mini" class="cleanup" bindtap="cleanup" loading="{{cleaning}}" disabled="{{cleaning}}">重试未完成的删除与清理</button></block><block wx:else><view wx:for="{{users}}" wx:key="id" class="card management-card"><view class="card-head"><view class="wall-name">{{item.displayName||'未设置昵称'}}</view><view class="status">{{item.isAdmin?'管理员':'普通用户'}}</view></view><view class="muted">注册于 {{item.date}}</view><view class="user-id">用户编号：{{item.id}}</view></view><view wx:if="{{!users.length && !loading && !error}}" class="empty">暂无用户。</view></block></block></view>
