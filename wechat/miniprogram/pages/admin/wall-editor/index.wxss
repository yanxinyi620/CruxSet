.annotation-page{padding:28rpx 28rpx 48rpx}.eyebrow{color:#6f7187;font-size:24rpx}.annotation-page .title{margin-top:20rpx}.canvas-wrap{height:66vh;min-height:600rpx;overflow:hidden;border-radius:18rpx;background:#eeeaf3;margin:20rpx 0}.canvas-wrap wall-canvas{display:block;height:100%}.tools,.mode-tools,.actions{display:flex;gap:12rpx;margin:20rpx 0;align-items:center}.tools button,.mode-tools button,.actions button{flex:1;margin:0;font-size:26rpx;padding:0 10rpx}.tools text{font-size:24rpx;color:#6f7187}.primary,.active{background:#6046d6;color:#fff}.hint{color:#6f7187;font-size:24rpx;line-height:1.6}.notice{background:#eeeaff;padding:18rpx;border-radius:12rpx;color:#4d389f;margin:18rpx 0;font-size:25rpx}.error-card{color:#a72f46;background:#fff1f3;padding:24rpx;border-radius:16rpx}.processor{position:fixed;left:-3000px;top:0;width:640px;height:640px;pointer-events:none}
