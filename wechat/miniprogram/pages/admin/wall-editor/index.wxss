.annotation-page{padding:26rpx 36rpx calc(40rpx + env(safe-area-inset-bottom))}.eyebrow{color:#6f7187;font-size:23rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.annotation-page .title{margin:12rpx 0}.annotation-page .page-lead{font-size:24rpx}.canvas-wrap{height:52vh;min-height:480rpx;max-height:1000rpx;overflow:hidden;border-radius:30rpx;background:#f2f2fa;margin:20rpx 0;box-shadow:0 12rpx 36rpx rgba(62,57,114,.10)}.canvas-wrap wall-canvas{display:block;width:100%;height:100%}.tools,.mode-tools,.actions{display:flex;gap:12rpx;margin:18rpx 0;align-items:center}.tools button,.mode-tools button,.actions button{box-sizing:border-box;flex:1;min-width:0;min-height:70rpx;margin:0;font-size:24rpx;line-height:1.4;padding:16rpx 8rpx;border:1rpx solid #ddddea;border-radius:20rpx;background:#fff;color:#555673;font-weight:800}.primary-tools button{min-height:82rpx;border-color:#4338b8;color:#4338b8;font-size:26rpx}.annotation-page .primary{background:#4338b8;border-color:#4338b8;color:#fff}.mode-tools .active,.add-options .active{background:#eeedff;border-color:#4338b8;color:#3730a3;box-shadow:inset 0 0 0 1rpx #4338b8}.history-tools{padding:14rpx;background:#f7f7fc;border:1rpx solid #ddddea;border-radius:24rpx;margin-top:12rpx}.history-tools button{min-height:62rpx;padding:12rpx 8rpx;border-radius:16rpx}.history-tools .clear{color:#b84b45;border-color:#efc1bd;background:#fffafa}.tools text{flex:1;min-width:0;font-size:23rpx;color:#6f7187;text-align:right}.add-options{padding:0 18rpx 10rpx;border:1rpx solid #e5e5ef;border-radius:22rpx;background:#fff}.add-options slider{margin:12rpx 8rpx}.hint{color:#6f7187;font-size:23rpx;line-height:1.6;word-break:break-all}.notice{background:#eeeaff;padding:18rpx 22rpx;border-radius:20rpx;color:#4d389f;margin:18rpx 0;font-size:24rpx;line-height:1.5;word-break:break-all}.error-card{color:#a72f46;background:#fff1f3;padding:24rpx;border-radius:20rpx;font-size:25rpx;line-height:1.5;word-break:break-all}.actions button{min-height:82rpx;font-size:26rpx}.annotation-page button[disabled]{opacity:.45}.processor{position:fixed;left:-3000px;top:0;width:640px;height:640px;pointer-events:none}
