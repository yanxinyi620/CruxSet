<view class="page annotation-page"><view wx:if="{{loading}}" class="empty">正在加载墙面…</view><view wx:elif="{{!allowed}}" class="empty">仅管理员可标注墙面。</view><view wx:if="{{error}}" class="error-card">{{error}}<button wx:if="{{!wall}}" size="mini" bindtap="retry">重试</button></view><block wx:if="{{allowed && wall}}"><view class="eyebrow">{{wall.name}}</view><view class="title">标注墙面</view><view class="page-lead">{{holdCount}} 个岩点 · {{locked?'公开并锁定':'私有草稿'}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view><block wx:if="{{!locked}}"><view class="tools primary-tools"><button class="primary" disabled="{{saving || detecting}}" loading="{{detecting}}" bindtap="detect">{{detecting?'识别中…':'自动识别'}}</button><button wx:if="{{detecting}}" bindtap="cancelDetect">取消</button><button data-mode="add" bindtap="setMode" disabled="{{saving || detecting}}">手动校准</button></view><view class="mode-tools"><button wx:for="{{['view','add','move','delete']}}" wx:key="*this" size="mini" class="{{mode===item?'active':''}}" data-mode="{{item}}" bindtap="setMode" disabled="{{saving || detecting}}">{{item==='view'?'查看':item==='add'?'添加':item==='move'?'移动':'删除'}}</button></view><view class="tools history-tools"><button size="mini" bindtap="undo" disabled="{{!canUndo || saving || detecting}}">撤销</button><button size="mini" bindtap="redo" disabled="{{!canRedo || saving || detecting}}">恢复</button><button class="clear" size="mini" bindtap="clear" disabled="{{saving || detecting}}">清空</button></view><view wx:if="{{mode==='add'}}" class="add-options"><view class="tools"><button size="mini" data-kind="hold" bindtap="setKind" class="{{kind==='hold'?'active':''}}">岩点</button><button size="mini" data-kind="volume" bindtap="setKind" class="{{kind==='volume'?'active':''}}">体积</button><text>大小 {{radius}}</text></view><slider min="5" max="100" value="{{radius}}" bindchange="setRadius" activeColor="#6046d6"/></view><view class="hint">{{hint}}</view></block><view class="canvas-wrap"><wall-canvas class="wall-surface" wall="{{wall}}" annotation="{{true}}" active-holds="{{selected}}" bind:imagepoint="onPoint"/></view><view wx:if="{{!locked}}" class="actions"><button bindtap="save" disabled="{{saving || detecting}}" loading="{{saving}}">保存草稿</button><button class="primary" bindtap="publish" disabled="{{holdCount<2 || saving || detecting}}">发布墙面</button></view><button wx:else class="primary" bindtap="browse">查看已发布墙面</button><view class="hint">发布至少需要两个岩点；公开后墙图与岩点不可修改。</view></block><canvas type="2d" id="imageProcessor" class="processor"/></view>
