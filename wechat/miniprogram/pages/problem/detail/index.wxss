.detail-page{padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}.detail-head{margin-bottom:18rpx}.detail-head .title{margin:0 0 10rpx;font-size:38rpx;line-height:1.3;letter-spacing:0}.detail-meta{color:#6f7187;font-size:25rpx;line-height:1.45;overflow-wrap:anywhere}.preview-card{padding:0;border:0;border-radius:20rpx;overflow:hidden}.canvas-wrap{height:620rpx;background:#f2f2fa}.fullscreen-button{display:block;margin:12rpx 0 0 auto;font-size:23rpx;min-height:60rpx;background:#fff;color:#5240bb}.legend{display:flex;flex-wrap:wrap;gap:14rpx 24rpx;margin:18rpx 0;color:#6f7187;font-size:22rpx}.legend>view{display:flex;align-items:center;gap:7rpx}.legend-dot{display:inline-block;width:18rpx;height:18rpx;border-radius:50%;flex:none}.legend-dot.start{background:#3fb96a}.legend-dot.foot{background:#f0c24b}.legend-dot.hand{background:#3f7bd9}.legend-dot.assist{background:#f08e63}.legend-dot.finish{background:#8f5fd9}.route-note{margin-top:18rpx;padding:22rpx 24rpx;border:1rpx solid #e3e2f1;border-radius:24rpx;background:#fafaff;color:#5f6178;font-size:25rpx;line-height:1.6;overflow-wrap:anywhere}.setter-row{display:flex;align-items:baseline;gap:16rpx}.setter-row .label{flex:none;font-size:22rpx;color:#85869a}.setter-name{min-width:0;overflow-wrap:anywhere}.note-text{margin-top:8rpx}.nav{display:flex;gap:16rpx;margin-top:26rpx}.nav button{flex:1;min-width:0;min-height:76rpx;padding:20rpx 12rpx;color:#5240bb;background:#fff;border:1rpx solid #d8d2f4;font-size:24rpx}.nav button[disabled]{color:#aaa8b8;background:#f5f5f7;border-color:#e6e5ea}.return-list{width:100%;margin-top:16rpx;font-size:24rpx;min-height:76rpx;padding:20rpx;color:#5240bb;border-color:#d8d2f4}
.fullscreen{position:fixed;inset:0;z-index:50;display:flex;flex-direction:column;background:#f8f8ff;padding:24rpx 18rpx calc(24rpx + env(safe-area-inset-bottom));box-sizing:border-box}.fullscreen-head{display:flex;align-items:center;gap:16rpx;font-size:24rpx;color:#28214b}.fullscreen-head text{flex:1;min-width:0;overflow-wrap:anywhere}.fullscreen-head button{flex:none}.fullscreen-canvas{flex:1;min-height:0;margin:20rpx 0}.fullscreen-canvas wall-canvas{height:100%;display:block}
