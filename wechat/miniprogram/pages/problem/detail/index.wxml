<view class="page detail-page"><view wx:if="{{error}}" class="error-card">{{error}}</view><block wx:if="{{problem}}"><view class="detail-head"><view class="eyebrow">线路详情</view><view class="title">{{problem.number}} {{problem.name}}</view><view class="detail-meta">{{wall.name}} · {{problem.angle}}° · {{problem.grade}} · {{footRuleLabel}}</view></view><view wx:if="{{error}}" class="error-card">{{error}}</view><view class="card preview-card"><view class="canvas-wrap"><wall-canvas wall="{{wall}}" active-holds="{{activeHolds}}"/></view></view><view class="legend"><view><i class="legend-dot start"></i>Start</view><view><i class="legend-dot foot"></i>Foot</view><view><i class="legend-dot hand"></i>Hand</view><view><i class="legend-dot assist"></i>Assist</view><view><i class="legend-dot finish"></i>Finish</view></view><view wx:if="{{problem.setterName || problem.description}}" class="route-note"><view class="label">设定者</view><view>{{problem.setterName || '用户'}}</view><view wx:if="{{problem.description}}" class="note-text">{{problem.description}}</view></view><view class="nav"><button size="mini" disabled="{{!previous}}" data-id="{{previous.id}}" bindtap="open">‹ 上一条</button><button size="mini" disabled="{{!next}}" data-id="{{next.id}}" bindtap="open">下一条 ›</button></view></view></block></view>