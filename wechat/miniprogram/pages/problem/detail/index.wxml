<view class="page detail-page"><view wx:if="{{loading}}" class="muted">正在加载线路…</view><view wx:if="{{error}}" class="error-card">{{error}}<button size="mini" bindtap="retry">重试</button></view><block wx:if="{{problem}}"><view class="detail-head"><view class="eyebrow">线路详情</view><view class="title">{{problem.number}} {{problem.name}}</view><view class="detail-meta">{{wall.name}} · {{problem.angle}}° · {{problem.grade}} · {{footRuleLabel}}</view></view><view wx:if="{{error}}" class="error-card">{{error}}<button size="mini" bindtap="retry">重试</button></view><view wx:if="{{!fullscreen}}" class="card preview-card"><view class="canvas-wrap"><wall-canvas wall="{{wall}}" active-holds="{{activeHolds}}"/></view></view><button size="mini" bindtap="openFullscreen">全屏预览</button><view class="legend"><view><i class="legend-dot start"></i>Start</view><view><i class="legend-dot foot"></i>Foot</view><view><i class="legend-dot hand"></i>Hand</view><view><i class="legend-dot assist"></i>Assist</view><view><i class="legend-dot finish"></i>Finish</view></view><view wx:if="{{problem.setterName || problem.description}}" class="route-note"><view class="label">设定者</view><view>{{problem.setterName || '用户'}}</view><view wx:if="{{problem.description}}" class="note-text">{{problem.description}}</view></view><view class="nav"><button size="mini" disabled="{{!previous}}" data-id="{{previous.id}}" bindtap="open">‹ 上一条</button><button size="mini" disabled="{{!next}}" data-id="{{next.id}}" bindtap="open">下一条 ›</button></view><button class="return-list" bindtap="backToList">返回线路列表</button><view wx:if="{{fullscreen}}" class="fullscreen"><view class="fullscreen-head"><text>{{problem.number}} · {{problem.grade}} · {{footRuleLabel}}</text><button size="mini" bindtap="closeFullscreen">关闭全屏</button></view><view class="fullscreen-canvas"><wall-canvas wall="{{wall}}" active-holds="{{activeHolds}}"/></view><view class="muted">单指拖动 · 双指缩放</view></view></block></view>