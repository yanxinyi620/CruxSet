<view class="page editor"><view wx:if="{{loading}}" class="quiet-empty">正在加载墙面…</view><view wx:if="{{error}}" class="error-card"><view>{{error}}</view><button size="mini" bindtap="back">返回</button></view><block wx:if="{{!loading && !error}}"><view class="editor-head"><view class="eyebrow">{{wall.name}}</view><view class="title">{{editing?'编辑线路':'新建线路'}}</view><view wx:if="{{editing}}" class="muted">线路编号：{{problemNumber}}</view></view><view class="route-options"><picker range="{{angles}}" value="{{angleIndex}}" bindchange="selectAngle"><view class="route-option"><view class="option-label">角度</view><view class="option-value">{{angle}}°</view></view></picker><picker range="{{grades}}" value="{{gradeIndex}}" bindchange="selectGrade"><view class="route-option"><view class="option-label">难度</view><view class="option-value">{{grade}}</view></view></picker><picker range="{{footRules}}" value="{{footRuleIndex}}" bindchange="selectFootRule"><view class="route-option"><view class="option-label">脚点规则</view><view class="option-value">{{footRuleLabel}}</view></view></picker></view><view class="canvas-wrap"><wall-canvas wall="{{wall}}" active-holds="{{selected}}" bind:holdtap="onHoldTap"/></view><view class="legend"><view wx:for="{{roles}}" wx:key="id"><i style="background:{{item.color}}"></i>{{item.label}}</view></view><view class="role-toolbar"><view wx:for="{{roles}}" wx:key="id" class="role {{selectedRole===item.id?'role-active':''}}" style="--role-color:{{item.color}}" data-role="{{item.id}}" bindtap="selectRole"><i style="background:{{item.color}}"></i>{{item.label}}</view></view><view class="actions"><button size="mini" bindtap="undo">撤销</button><button size="mini" bindtap="clear">清空</button><button class="save" disabled="{{loadError || saving}}" loading="{{saving}}" bindtap="save">{{editing?'更新线路':'保存线路'}}</button></view><view class="card fields"><view class="field-label">线路名称</view><input class="field" placeholder="可选" value="{{name}}" bindinput="setName" maxlength="80"/><view class="field-label">线路说明</view><textarea class="field description" placeholder="可选，500字以内" value="{{description}}" bindinput="setDescription" maxlength="500"/></view><view class="muted rule-hint">当前规则：{{footRuleHint}}</view></block></view>
