.editor{padding:20rpx 36rpx calc(32rpx + env(safe-area-inset-bottom))}.editor-head{display:none}.route-options{display:flex;gap:14rpx;margin:0 0 24rpx}.route-options picker{flex:1;min-width:0}.route-option{padding:14rpx 12rpx;background:#fff;border:1rpx solid #e5e5ef;border-radius:20rpx}.option-label{color:#6f7187;font-size:20rpx;font-weight:800}.option-value{margin-top:4rpx;color:#202039;font-size:24rpx;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.canvas-wrap{height:calc(100vh - 420rpx);min-height:440rpx;max-height:1100rpx;border-radius:30rpx;overflow:hidden;background:#f2f2fa;box-shadow:0 12rpx 36rpx rgba(62,57,114,.10)}.canvas-wrap wall-canvas,.save-preview wall-canvas{display:block;width:100%;height:100%}.role-toolbar{display:flex;gap:12rpx;margin:26rpx 0}.role{box-sizing:border-box;flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6rpx;min-height:78rpx;padding:12rpx 4rpx;border:1rpx solid #e5e5ef;border-radius:20rpx;background:#fff;color:#4d4f66;font-size:21rpx;font-weight:800}.role-dot{width:23rpx;height:23rpx;flex:none;border-radius:50%}.role-active{border-color:#6046d6;box-shadow:0 0 0 3rpx #6046d6}.actions{display:flex;gap:16rpx;align-items:center;margin:26rpx 0 18rpx}.actions button{flex:1;min-width:0;margin:0;padding:20rpx 8rpx;min-height:80rpx;font-size:26rpx;border:1rpx solid #e5e5ef;border-radius:22rpx;background:#fff;color:#4d4f66;font-weight:800}.actions .save{background:#6046d6;border-color:#6046d6;color:#fff}.actions button[disabled]{opacity:.45}.rule-hint{display:block;margin:12rpx 0;color:#6f7187;font-size:23rpx;line-height:1.55;word-break:break-all}.editor .legend{display:none}
.save-dialog-mask{position:fixed;inset:0;z-index:30;box-sizing:border-box;display:flex;align-items:center;justify-content:center;padding:32rpx 46rpx calc(32rpx + env(safe-area-inset-bottom));background:rgba(39,34,68,.4)}.save-dialog{box-sizing:border-box;width:100%;max-width:650rpx;height:calc(100vh - 100rpx - env(safe-area-inset-bottom));max-height:1050rpx;overflow:hidden;border-radius:34rpx;background:#fff;box-shadow:0 30rpx 90rpx rgba(39,34,68,.3)}.save-dialog-content{padding:34rpx}.save-dialog-title{font-size:36rpx;font-weight:800;line-height:1.3}.preview-label{margin-top:18rpx;color:#6f7187;font-size:22rpx;font-weight:700}.save-preview{height:260rpx;margin:10rpx 0 18rpx;overflow:hidden;border-radius:20rpx;background:#f2f2fa}.field-label{margin:18rpx 0 10rpx;color:#6f7187;font-size:23rpx;font-weight:800}.field{box-sizing:border-box;width:100%;height:78rpx;margin:0;padding:18rpx;border:1rpx solid #e5e5ef;border-radius:20rpx;background:#fff;font-size:26rpx;line-height:1.4}.description{height:112rpx}.save-dialog button{width:100%;margin:18rpx 0 0;min-height:78rpx;padding:18rpx;border:1rpx solid #e5e5ef;border-radius:20rpx;background:#fff;font-size:26rpx;font-weight:800}.save-dialog .dialog-confirm{background:#6046d6;border-color:#6046d6;color:#fff}.error-card{padding:24rpx;border-radius:20rpx;background:#fff1f3;color:#a72f46;font-size:26rpx;line-height:1.5;word-break:break-all}.error-card button{margin-top:18rpx}.quiet-empty{padding:80rpx 0;text-align:center;color:#8a8b9d;font-size:26rpx}
