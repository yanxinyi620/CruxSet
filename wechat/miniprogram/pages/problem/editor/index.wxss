.editor{padding-bottom:70rpx}.editor-head{margin-bottom:22rpx}.route-options{display:flex;gap:12rpx;margin:20rpx 0}.route-options picker{flex:1}.route-option{padding:18rpx 12rpx;background:#fff;border:1rpx solid #e5e5ef;border-radius:16rpx}.option-label{color:#788074;font-size:21rpx}.option-value{margin-top:8rpx;color:#6046d6;font-size:27rpx;font-weight:800}.canvas-wrap{height:600rpx;border-radius:24rpx;overflow:hidden;margin-bottom:18rpx;border:1rpx solid #e5e5ef}.legend{display:flex;flex-wrap:wrap;gap:18rpx;margin:16rpx 4rpx;color:#5f6172;font-size:23rpx}.legend view,.role{display:flex;align-items:center;justify-content:center;gap:8rpx}.legend i,.role i{width:18rpx;height:18rpx;border-radius:50%;display:inline-block}.role-toolbar{display:flex;gap:10rpx;margin:20rpx 0}.role{flex:1;padding:16rpx 4rpx;border-radius:16rpx;background:#f1effb;color:var(--role-color);font-size:21rpx;font-weight:700}.role-active{background:var(--role-color);color:#fff}.actions{display:flex;gap:14rpx;align-items:center;margin:24rpx 0}.actions button{border-radius:14rpx}.save{flex:1;background:#6046d6;color:#fff}.fields{padding:22rpx}.field-label{font-size:23rpx;color:#788074;margin:8rpx 0}.field{box-sizing:border-box;background:#fff;border:1rpx solid #e5e5ef;border-radius:14rpx;padding:20rpx 22rpx;margin:8rpx 0 18rpx;width:100%}.description{height:140rpx}.rule-hint{display:block;margin:12rpx 4rpx}
