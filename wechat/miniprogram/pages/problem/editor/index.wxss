.editor{padding-bottom:70rpx}.meta-row{display:flex;gap:14rpx;margin:18rpx 0}.meta{background:#eeeaff;color:#6046d6;padding:16rpx 28rpx;border-radius:999rpx;font-weight:700}.canvas-wrap{height:600rpx;border-radius:24rpx;overflow:hidden;margin-bottom:24rpx;border:1rpx solid #e5e5ef}.legend{display:flex;flex-wrap:wrap;gap:18rpx;margin:18rpx 0;color:#5f6172;font-size:23rpx}.legend view{display:flex;align-items:center;gap:8rpx}.legend i{width:18rpx;height:18rpx;border-radius:50%;display:inline-block}.role-row{display:flex;gap:10rpx;margin-bottom:24rpx}.role{flex:1;text-align:center;padding:18rpx 4rpx;border-radius:16rpx;background:#f1effb;color:var(--role-color);font-size:22rpx;font-weight:700}.role-active{background:var(--role-color);color:#fff}.rule-title{font-weight:700;margin-bottom:12rpx}.rule .muted{display:block;margin-top:8rpx}.field{box-sizing:border-box;background:#fff;border:1rpx solid #e5e5ef;border-radius:16rpx;padding:22rpx 24rpx;margin:16rpx 0;width:100%}.description{height:150rpx}.hold-grid{display:flex;flex-wrap:wrap;gap:12rpx;margin:24rpx 0}.hold{font-size:22rpx;padding:14rpx 18rpx;background:#fff;border:1rpx solid #e5e5ef;border-radius:12rpx;color:#6046d6}.hold-selected{background:#6046d6;color:#fff}.actions{display:flex;gap:14rpx;align-items:center;margin-top:24rpx}.actions button{border-radius:14rpx}.save{flex:1;background:#6046d6;color:#fff}.error-card{margin-bottom:18rpx}
