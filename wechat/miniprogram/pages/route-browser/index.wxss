.title{font-size:44rpx;margin-bottom:24rpx}.filter-buttons{display:flex;gap:16rpx;margin:24rpx 0}.filter-buttons picker{flex:1;min-width:0}.filter-select{display:flex;justify-content:space-between;align-items:center;min-height:80rpx;padding:18rpx 20rpx;background:#fff;border:1rpx solid #d8d2f4;color:#5240bb;border-radius:22rpx;font-size:24rpx;font-weight:700}.problem-list{overflow:hidden;border:1rpx solid #e3e2f1;border-radius:28rpx;background:#fff}.problem{display:flex;align-items:center;gap:20rpx;min-height:96rpx;padding:20rpx 24rpx;border-bottom:1rpx solid #eeeef4}.problem:last-child{border-bottom:0}.problem-number{flex:none;color:#5240bb;font-size:25rpx;font-weight:800}.problem .muted{min-width:0;font-size:24rpx;overflow-wrap:anywhere}.empty{text-align:center;color:#85869a;padding:60rpx 16rpx;font-size:26rpx}
