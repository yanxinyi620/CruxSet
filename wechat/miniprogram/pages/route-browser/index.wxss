.title{font-size:46rpx;margin-bottom:24rpx}.filter-buttons{display:flex;gap:18rpx;margin:20rpx 0}.filter-buttons button{flex:1;background:#fff;border:1rpx solid #ddd9ef;color:#6046d6;border-radius:16rpx;font-size:26rpx}.filter-sheet{position:fixed;inset:0;z-index:20}.sheet-mask{position:absolute;inset:0;background:rgba(20,16,40,.35)}.sheet-panel{position:absolute;left:0;right:0;bottom:0;padding:30rpx;border-radius:28rpx 28rpx 0 0;background:#fff}.sheet-title{font-size:32rpx;font-weight:800;margin-bottom:20rpx}.sheet-options{display:flex;flex-wrap:wrap;gap:16rpx}.sheet-options button{width:calc(25% - 12rpx);background:#eeeaff;color:#6046d6}.sheet-close{margin-top:20rpx;background:#f5f3fb}.problem{margin-top:18rpx}.problem-number{font-size:32rpx;font-weight:700}.empty{text-align:center;color:#8a8b9d;padding:100rpx 0}
