.wall-picker-page{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.wall-picker-page .title{margin-top:0}.wall-picker-page .page-lead{font-size:25rpx;margin-bottom:26rpx}.wall-picker-card{display:flex;align-items:center;gap:22rpx;margin-top:22rpx;padding:28rpx;border-radius:30rpx;box-shadow:none}.wall-visual{flex:0 0 auto;width:80rpx;height:80rpx;border-radius:23rpx;background:linear-gradient(145deg,#6f68d5 0 36%,#f39263 36% 68%,#f5d77e 68%)}.wall-picker-copy{min-width:0;flex:1}.title-small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:30rpx;font-weight:800;line-height:1.4}.wall-picker-copy .muted{margin-top:6rpx;font-size:23rpx}.wall-arrow{flex:none;color:#6046d6;font-size:40rpx;line-height:1}
