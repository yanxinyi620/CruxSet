<view class="page wall-picker-page"><view class="title">{{mode==='create'?'新建线路':'选择公开墙面'}}</view><view class="page-lead">{{mode==='create'?'选择一面已发布墙面开始定线。':'选择一面公开墙面。'}}</view><view wx:for="{{items}}" wx:key="id" class="card wall-picker-card" data-wall-id="{{item.id}}" bindtap="choose"><view class="wall-visual"></view><view class="wall-picker-copy"><view class="title-small">{{item.name}}</view><view class="muted">公开 · {{item.holdCount}} 个岩点</view></view><view class="wall-arrow">›</view></view><view wx:if="{{!items.length}}" class="empty">暂无可选择的公开墙面</view></view>
