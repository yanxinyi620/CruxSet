page{background:#f8f8ff;color:#22213d;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.5}
view,button,input,textarea,picker{box-sizing:border-box}
.page{min-height:100vh;padding:32rpx 36rpx calc(48rpx + env(safe-area-inset-bottom))}
.lines-page,.create-page,.me-hub{padding-bottom:calc(144rpx + env(safe-area-inset-bottom))}
button{margin:0;min-height:80rpx;padding:20rpx 24rpx;border:1rpx solid #e3e2f1;border-radius:22rpx;background:#fff;color:#5240bb;font-size:28rpx;font-weight:700;line-height:1.4;white-space:normal}
button::after{border:0}button[size="mini"]{min-height:64rpx;padding:14rpx 20rpx;font-size:24rpx;line-height:1.4}button[disabled]{background:#f5f5f7;color:#aaa8b8;border-color:#e6e5ea}
.preview-top{display:flex;align-items:center;justify-content:space-between;color:#6f7187;font-size:22rpx;font-weight:800;margin:4rpx 0 40rpx}
.preview-avatar{width:48rpx;height:48rpx;border-radius:50%;background:linear-gradient(140deg,#ef7655,#f6c75c)}
.page-title,.title{margin:0 0 14rpx;font-size:44rpx;font-weight:800;letter-spacing:0;line-height:1.25;overflow-wrap:anywhere}
.lines-page>.page-title,.create-page>.page-title,.me-hub>.page-title{font-size:64rpx;letter-spacing:3rpx}
.page-lead,.muted{color:#6f7187;font-size:26rpx;line-height:1.55}.eyebrow{font-size:22rpx;font-weight:700;color:#85869a;margin-bottom:8rpx}
.card{background:#fff;border:1rpx solid #e3e2f1;border-radius:28rpx;padding:26rpx;box-shadow:none}
.button,.primary{border-radius:24rpx;background:#6352e2;color:#fff;font-weight:800}
.empty,.quiet-empty{padding:56rpx 16rpx;text-align:center;color:#85869a;font-size:26rpx;line-height:1.6}
.error-card{margin:24rpx 0;padding:24rpx;border:1rpx solid #efc1b7;border-radius:22rpx;background:#fff3ef;color:#a44134;font-size:26rpx;line-height:1.6;overflow-wrap:anywhere}.error-card button{margin-top:16rpx}
input,textarea{font-size:28rpx;color:#22213d;line-height:1.5}.label{font-size:24rpx;font-weight:700;color:#6f7187}

.wall-surface{display:block;width:100%;height:100%}
.page button:not([size="mini"]){width:100%}
